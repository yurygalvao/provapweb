<h1>Categorias</h1>
<a href="/categorias/nova">Nova Categoria</a>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Nome</th>
    </tr>
  </thead>
  <tbody>
    <% categorias.forEach(function(categoria) { %>
      <tr>
        <td>#<%= categoria.id %></td>
        <td><%= categoria.nome %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
