<h1>Produtos</h1>
<a href="/produtos/novo">Novo Produto</a>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Preço</th>
      <th>Categoria</th>
    </tr>
  </thead>
  <tbody>
    <% produtos.forEach(function(produto) { %>
      <tr>
        <td><%= produto.nome %></td>
        <td>R$ <%= produto.preco.toFixed(2) %></td>
        <td><%= produto.categoria.nome %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
